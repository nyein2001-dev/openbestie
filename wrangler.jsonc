{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openbestie-local",
  "main": "src/index.tsx",
  "compatibility_date": "2026-11-26",
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "STAGE": "local" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openbestie-local",
      "database_id": "91bb6e29-4cf1-4b71-85f4-3594e8d706ba"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "openbestie-local" }],
  "ratelimits": [
    { "name": "FEEDBACK_LIMIT", "namespace_id": "11001", "simple": { "limit": 5, "period": 60 } }
  ],
  "triggers": { "crons": ["17 2 * * *"] },
  "observability": { "enabled": false }
}
