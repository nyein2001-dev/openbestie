{
  "name": "openbestie-browser-fixture",
  "main": "browser-worker.ts",
  "compatibility_date": "2026-11-26",
  "assets": { "directory": "../public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openbestie-browser-fixture",
      "database_id": "91bb6e29-4cf1-4b71-85f4-3594e8d706bc",
      "migrations_dir": "../migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "openbestie-browser-fixture" }],
  "ratelimits": [
    { "name": "FEEDBACK_LIMIT", "namespace_id": "11004", "simple": { "limit": 60, "period": 60 } }
  ]
}
